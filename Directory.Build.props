<Project>
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- PROPVARIANT и другие структуры интеропа размечены под x64 -->
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- строки: Resources\*.resx — английский (нейтральный), *.ru.resx — русский (сателлитная сборка ru);
         классы доступа генерирует tools/gen-strings.ps1 -->
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>

    <!-- версия выпуска: видна в свойствах exe и в первой строке журнала -->
    <Version>2.1.0</Version>
    <Product>Mixer</Product>
    <Copyright>© 2026</Copyright>
  </PropertyGroup>
</Project>
