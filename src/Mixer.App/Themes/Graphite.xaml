<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Тема Graphite: обычная тёмная (макет «Главное окно»).
         Набор ключей у всех тем один и тот же (Graphite.xaml, Daylight.xaml, Modular.xaml), это проверяет автотест:
         пропущенный ключ со StaticResource оборачивается падением при запуске. Стили — в Styles.xaml. -->

    <!-- ── цвета ── -->
    <Color x:Key="BgColor">#15171A</Color>  <!-- фон холста -->
    <Color x:Key="BarColor">#1A1C20</Color>  <!-- шапка, подвал -->
    <Color x:Key="CardColor">#1E2125</Color>  <!-- карточка, диалог -->
    <Color x:Key="RaisedColor">#22252A</Color>  <!-- кнопки, строки -->
    <Color x:Key="Raised2Color">#2A2E34</Color>  <!-- наведение -->
    <Color x:Key="LineColor">#2C3036</Color>  <!-- рамки -->
    <Color x:Key="LineStrongColor">#3A3F46</Color>  <!-- рамки поярче -->
    <Color x:Key="TextColor">#E8EAED</Color>  <!-- основной текст -->
    <Color x:Key="Text2Color">#C4C8CD</Color>  <!-- второй текст -->
    <Color x:Key="MutedColor">#9AA0A6</Color>  <!-- подписи (контраст ≥ 4,5:1 к Card) -->
    <Color x:Key="FaintColor">#6B7178</Color>  <!-- совсем второстепенное -->
    <Color x:Key="AccentColor">#4FA3FF</Color>  <!-- акцент -->
    <Color x:Key="GreenColor">#3DCC91</Color>  <!-- норма, индикатор -->
    <Color x:Key="RedColor">#F28B82</Color>  <!-- ошибка, перегруз, mute -->
    <Color x:Key="YellowColor">#FFC44D</Color>  <!-- предупреждение -->
    <Color x:Key="Source0Color">#4FA3FF</Color>  <!-- палитра источников -->
    <Color x:Key="Source1Color">#FF9A4D</Color>
    <Color x:Key="Source2Color">#3DCC91</Color>
    <Color x:Key="Source3Color">#B18CFF</Color>
    <Color x:Key="Source4Color">#F2C94C</Color>
    <Color x:Key="Source5Color">#FF6B9A</Color>
    <Color x:Key="Source6Color">#4DD0E1</Color>
    <Color x:Key="Source7Color">#A3D977</Color>
    <Color x:Key="WireOffColor">#5F656D</Color>  <!-- выключенный провод -->
    <Color x:Key="WireNeutralColor">#C4C8CD</Color>  <!-- провод из шины, фейдер выхода -->
    <Color x:Key="MeterTrackColor">#26292E</Color>  <!-- дорожка индикатора -->
    <Color x:Key="MeterHoldColor">#C4C8CD</Color>  <!-- метка пика -->
    <Color x:Key="EqBgColor">#17191C</Color>  <!-- фон кривой EQ -->
    <Color x:Key="KnobActiveColor">#FFFFFF</Color>  <!-- бегунок под мышью, включённый переключатель -->
    <Color x:Key="PanelAluColor">#D3D0C9</Color>  <!-- Modular: источник — алюминий -->
    <Color x:Key="PanelBlackColor">#1D1E21</Color>  <!-- Modular: шина — чёрная -->
    <Color x:Key="PanelCreamColor">#ECE3CE</Color>  <!-- Modular: выход — кремовый -->
    <Color x:Key="PanelInkColor">#1B1B1C</Color>  <!-- Modular: надписи на светлой панели -->
    <Color x:Key="PanelInkLightColor">#EDECE8</Color>  <!-- Modular: надписи на чёрной панели -->
    <Color x:Key="PanelMutedColor">#5C5A55</Color>  <!-- Modular: мелкие надписи на светлой панели -->
    <Color x:Key="PanelMutedLightColor">#9C9A94</Color>  <!-- Modular: мелкие надписи на чёрной панели -->
    <Color x:Key="RailColor">#2B2C30</Color>  <!-- Modular: рейка стойки -->
    <Color x:Key="ScrewColor">#8D8B86</Color>  <!-- Modular: винты, ободок гнезда -->
    <Color x:Key="KnobBodyColor">#151617</Color>  <!-- Modular: ручка -->
    <Color x:Key="LedOffColor">#3A3A38</Color>  <!-- Modular: погасший светодиод -->
    <Color x:Key="JackHoleColor">#0A0A0A</Color>  <!-- Modular: отверстие гнезда -->

    <!-- ── кисти ── -->
    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Bar" Color="{StaticResource BarColor}" />
    <SolidColorBrush x:Key="Card" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="Raised" Color="{StaticResource RaisedColor}" />
    <SolidColorBrush x:Key="Raised2" Color="{StaticResource Raised2Color}" />
    <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="LineStrong" Color="{StaticResource LineStrongColor}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Text2" Color="{StaticResource Text2Color}" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="Faint" Color="{StaticResource FaintColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="Green" Color="{StaticResource GreenColor}" />
    <SolidColorBrush x:Key="Red" Color="{StaticResource RedColor}" />
    <SolidColorBrush x:Key="Yellow" Color="{StaticResource YellowColor}" />
    <SolidColorBrush x:Key="Source0" Color="{StaticResource Source0Color}" />
    <SolidColorBrush x:Key="Source1" Color="{StaticResource Source1Color}" />
    <SolidColorBrush x:Key="Source2" Color="{StaticResource Source2Color}" />
    <SolidColorBrush x:Key="Source3" Color="{StaticResource Source3Color}" />
    <SolidColorBrush x:Key="Source4" Color="{StaticResource Source4Color}" />
    <SolidColorBrush x:Key="Source5" Color="{StaticResource Source5Color}" />
    <SolidColorBrush x:Key="Source6" Color="{StaticResource Source6Color}" />
    <SolidColorBrush x:Key="Source7" Color="{StaticResource Source7Color}" />
    <SolidColorBrush x:Key="WireOff" Color="{StaticResource WireOffColor}" />
    <SolidColorBrush x:Key="WireNeutral" Color="{StaticResource WireNeutralColor}" />
    <SolidColorBrush x:Key="MeterTrack" Color="{StaticResource MeterTrackColor}" />
    <SolidColorBrush x:Key="MeterHold" Color="{StaticResource MeterHoldColor}" />
    <SolidColorBrush x:Key="EqBg" Color="{StaticResource EqBgColor}" />
    <SolidColorBrush x:Key="KnobActive" Color="{StaticResource KnobActiveColor}" />
    <SolidColorBrush x:Key="PanelAlu" Color="{StaticResource PanelAluColor}" />
    <SolidColorBrush x:Key="PanelBlack" Color="{StaticResource PanelBlackColor}" />
    <SolidColorBrush x:Key="PanelCream" Color="{StaticResource PanelCreamColor}" />
    <SolidColorBrush x:Key="PanelInk" Color="{StaticResource PanelInkColor}" />
    <SolidColorBrush x:Key="PanelInkLight" Color="{StaticResource PanelInkLightColor}" />
    <SolidColorBrush x:Key="PanelMuted" Color="{StaticResource PanelMutedColor}" />
    <SolidColorBrush x:Key="PanelMutedLight" Color="{StaticResource PanelMutedLightColor}" />
    <SolidColorBrush x:Key="Rail" Color="{StaticResource RailColor}" />
    <SolidColorBrush x:Key="Screw" Color="{StaticResource ScrewColor}" />
    <SolidColorBrush x:Key="KnobBody" Color="{StaticResource KnobBodyColor}" />
    <SolidColorBrush x:Key="LedOff" Color="{StaticResource LedOffColor}" />
    <SolidColorBrush x:Key="JackHole" Color="{StaticResource JackHoleColor}" />
    <SolidColorBrush x:Key="AccentSoft" Color="#2A3A52" />
    <SolidColorBrush x:Key="GreenSoft" Color="#243DCC91" />
    <SolidColorBrush x:Key="GreenText" Color="#6FE0B0" />
    <SolidColorBrush x:Key="RedSoft" Color="#29F28B82" />
    <SolidColorBrush x:Key="RedDeep" Color="#3A2423" />
    <SolidColorBrush x:Key="RedPale" Color="#FBD3CF" />
    <SolidColorBrush x:Key="RedBorder" Color="#5C2B2E" />
    <SolidColorBrush x:Key="YellowSoft" Color="#29FFC44D" />
    <SolidColorBrush x:Key="YellowBorder" Color="#80FFC44D" />
    <SolidColorBrush x:Key="Scrim" Color="#B3101215" />
    <SolidColorBrush x:Key="OnAccent" Color="#0E1116" />
    <SolidColorBrush x:Key="OnRed" Color="#1A0E0D" />
    <SolidColorBrush x:Key="DialogBorder" Color="#33373D" />
    <SolidColorBrush x:Key="ChipBorder" Color="#4D4FA3FF" />
    <SolidColorBrush x:Key="WaitingBorder" Color="#4A4F56" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <!-- надписи панелей Modular: Oswald (SIL OFL) встроен в Mixer.exe -->
    <FontFamily x:Key="PanelFont">pack://application:,,,/Mixer;component/Fonts/#Oswald</FontFamily>
    <sys:Boolean xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="IsDarkTheme">True</sys:Boolean>

</ResourceDictionary>
