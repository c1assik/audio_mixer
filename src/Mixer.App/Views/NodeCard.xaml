<UserControl x:Class="Mixer.App.Views.NodeCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Mixer.App.Ui"
             xmlns:res="clr-namespace:Mixer.App.Resources"
             Width="248" MinHeight="118" FontFamily="{StaticResource UiFont}" FontSize="13">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />
    </UserControl.Resources>
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Opacity" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSilent}" Value="True">
                    <Setter Property="Opacity" Value="0.6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                    <Setter Property="Opacity" Value="0.35" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Grid>
        <!-- рамка: Rectangle, а не Border, ради пунктира у «ждёт» -->
        <Rectangle RadiusX="12" RadiusY="12" SnapsToDevicePixels="True">
            <Rectangle.Style>
                <Style TargetType="Rectangle">
                    <Setter Property="Fill" Value="{StaticResource Card}" />
                    <Setter Property="Stroke" Value="{StaticResource Line}" />
                    <Setter Property="StrokeThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Look}" Value="Waiting">
                            <Setter Property="Fill" Value="{StaticResource Bar}" />
                            <Setter Property="Stroke" Value="{StaticResource WaitingBorder}" />
                            <Setter Property="StrokeDashArray" Value="4 3" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Look}" Value="Error">
                            <Setter Property="Stroke" Value="{StaticResource Red}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasLimiter}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource YellowBorder}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource Accent}" />
                            <Setter Property="StrokeThickness" Value="1.5" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Rectangle.Style>
        </Rectangle>

        <Border Padding="14,12" Background="Transparent" ui:Ui.Role="card">
            <StackPanel>
                <Grid Height="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>

                    <!-- значок типа -->
                    <Border Width="32" Height="32" CornerRadius="8" ui:Ui.Role="card" Cursor="SizeAll">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{Binding TintBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOutput}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Raised2}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBus}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Raised2}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Muted}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Raised2}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Look}" Value="Waiting">
                                        <Setter Property="Background" Value="{StaticResource Raised}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Look}" Value="Error">
                                        <Setter Property="Background" Value="{StaticResource RedSoft}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <ui:Icon Data="{Binding Glyph}">
                                <ui:Icon.Style>
                                    <Style TargetType="ui:Icon">
                                        <Setter Property="Foreground" Value="{Binding ColorBrush}" />
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOutput}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsBus}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Muted}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Look}" Value="Waiting">
                                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Look}" Value="Error">
                                                <Setter Property="Foreground" Value="{StaticResource Red}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasAppIcon}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Icon.Style>
                            </ui:Icon>
                            <Image Source="{Binding AppIcon}" Width="20" Height="20" IsHitTestVisible="False"
                                   Visibility="{Binding HasAppIcon, Converter={StaticResource Vis}}" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>

                    <!-- имя и подпись -->
                    <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock x:Name="NameText" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       ui:TrimTip.IsEnabled="True" ui:TrimTip.Extra="{Binding Tooltip}" MouseLeftButtonDown="OnNameDown" ui:Ui.Role="card">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Muted}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Text2}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Look}" Value="Waiting">
                                                <Setter Property="Foreground" Value="{StaticResource Text2}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="NameBox" FontSize="14" FontWeight="SemiBold" Margin="-5,-3,0,-3" Padding="2,1"
                                     Visibility="{Binding IsRenaming, Converter={StaticResource Vis}}"
                                     IsVisibleChanged="OnNameBoxVisible" KeyDown="OnNameBoxKey" LostKeyboardFocus="OnNameBoxLostFocus" />
                        </Grid>
                        <TextBlock Text="{Binding Subtitle}" FontSize="12" TextTrimming="CharacterEllipsis" ui:TrimTip.IsEnabled="True" ui:TrimTip.Extra="{Binding Tooltip}" ui:Ui.Role="card">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SubtitleWarn}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Yellow}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Look}" Value="Error">
                                            <Setter Property="Foreground" Value="{StaticResource Red}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- значки: лимитер, предупреждения -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- «Весь звук системы»: что не захвачено и почему -->
                        <Border CornerRadius="9" Padding="7,2" Background="{StaticResource Raised2}" Margin="0,0,4,0"
                                Visibility="{Binding HasSkipped, Converter={StaticResource Vis}}" ToolTipService.InitialShowDelay="150"
                                ToolTipService.ShowDuration="30000" AutomationProperties.Name="{Binding SkippedText}">
                            <Border.ToolTip>
                                <TextBlock Text="{Binding SkippedTip}" MaxWidth="420" TextWrapping="Wrap" />
                            </Border.ToolTip>
                            <TextBlock Text="{Binding SkippedText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text2}" />
                        </Border>
                        <Border CornerRadius="9" Padding="7,2" Background="{StaticResource YellowSoft}" Margin="0,0,4,0"
                                Visibility="{Binding HasLimiter, Converter={StaticResource Vis}}"
                                ToolTip="{x:Static res:Strings.Node_LimiterTip}">
                            <TextBlock Text="{Binding LimiterText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Yellow}" />
                        </Border>
                        <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource YellowSoft}" Margin="0,0,2,0"
                                Visibility="{Binding HasWarnings, Converter={StaticResource Vis}}" ToolTipService.InitialShowDelay="150"
                                ToolTipService.ShowDuration="30000">
                            <Border.ToolTip>
                                <TextBlock Text="{Binding Warnings}" />
                            </Border.ToolTip>
                            <ui:Icon Data="{StaticResource IconWarn}" Foreground="{StaticResource Yellow}" Width="14" Height="14" />
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="28" Height="28" Click="OnMenuClick" ToolTip="{x:Static res:Strings.Node_Menu}"
                            AutomationProperties.Name="{x:Static res:Strings.Node_Menu}">
                        <ui:Icon Data="{StaticResource IconMenu}" Foreground="{StaticResource Muted}" Width="16" Height="16" StrokeThickness="2.6" />
                    </Button>
                </Grid>

                <!-- фейдер, M, индикатор -->
                <StackPanel Visibility="{Binding ShowBody, Converter={StaticResource Vis}}" Cursor="Arrow">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="32" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="Fader" Style="{StaticResource Fader}" Value="{Binding GainDb, Mode=TwoWay}" Foreground="{Binding FaderBrush}"
                                VerticalAlignment="Center" ToolTip="{x:Static res:Strings.Node_FaderTip}"
                                PreviewMouseLeftButtonDown="OnFaderDown" PreviewMouseMove="OnFaderMove" PreviewMouseLeftButtonUp="OnFaderUp"
                                LostMouseCapture="OnFaderLost" PreviewMouseWheel="OnFaderWheel" />
                        <TextBlock Grid.Column="1" Text="{Binding GainText}" FontSize="12" TextAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Muted}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ToggleButton Grid.Column="2" Style="{StaticResource MuteButton}" IsChecked="{Binding Muted, Mode=TwoWay}" ToolTip="{x:Static res:Strings.Node_MuteTip}"
                                      AutomationProperties.Name="{x:Static res:Strings.Node_Mute}" />
                    </Grid>
                    <!-- обработка: «+ FX» или чипы включённых блоков и подавление компрессора -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Height="22">
                        <Button Style="{StaticResource FxButton}" Content="{x:Static res:Strings.Fx_Add}" Command="{Binding OpenChainCommand}"
                                ToolTip="{x:Static res:Strings.Fx_AddTip}" Visibility="{Binding ShowFx, Converter={StaticResource Vis}}" />
                        <Button Style="{StaticResource ChipButton}" Content="{x:Static res:Strings.Fx_Gate}" Command="{Binding OpenChainCommand}" CommandParameter="gate"
                                ToolTip="{x:Static res:Strings.Fx_ChipTip}" Visibility="{Binding HasGate, Converter={StaticResource Vis}}" />
                        <Button Style="{StaticResource ChipButton}" Content="{x:Static res:Strings.Fx_Eq}" Command="{Binding OpenChainCommand}" CommandParameter="eq"
                                ToolTip="{x:Static res:Strings.Fx_ChipTip}" Visibility="{Binding HasEq, Converter={StaticResource Vis}}" />
                        <Button Style="{StaticResource ChipButton}" Content="{x:Static res:Strings.Fx_Comp}" Command="{Binding OpenChainCommand}" CommandParameter="comp"
                                ToolTip="{x:Static res:Strings.Fx_ChipTip}" Visibility="{Binding HasComp, Converter={StaticResource Vis}}" />
                        <!-- плагины: сколько включено; точка — один из них в сбое -->
                        <Button Style="{StaticResource ChipButton}" Command="{Binding OpenChainCommand}" CommandParameter="fx"
                                ToolTip="{x:Static res:Strings.Plugin_ChipTip}" Visibility="{Binding HasPlugins, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding FxText}" />
                                <Ellipse Width="6" Height="6" Fill="{StaticResource Yellow}" Margin="4,0,0,0" VerticalAlignment="Center"
                                         Visibility="{Binding PluginFault, Converter={StaticResource Vis}}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding ReductionText}" Foreground="{StaticResource Yellow}" FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center"
                                   ToolTip="{x:Static res:Strings.Fx_ReductionTip}" Visibility="{Binding HasReduction, Converter={StaticResource Vis}}" />
                        <!-- кабель-микрофон: кому назначен -->
                        <TextBlock Text="{Binding MicForText}" Foreground="{StaticResource Muted}" FontSize="12" Margin="2,0,0,0" VerticalAlignment="Center"
                                   MaxWidth="200" TextTrimming="CharacterEllipsis" ToolTip="{Binding MicForTip}" ToolTipService.ShowDuration="30000"
                                   Visibility="{Binding HasMicFor, Converter={StaticResource Vis}}" />
                    </StackPanel>
                    <ui:MeterBar Margin="0,8,0,0" Meter="{Binding Meter}" />
                </StackPanel>

                <!-- ждёт или ошибка: причина словами и что сделать -->
                <StackPanel Margin="0,10,0,0" Cursor="Arrow">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowBody}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Icon Data="{StaticResource IconClock}" Foreground="{StaticResource Muted}" Width="14" Height="14" Margin="0,1,8,0" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" LineHeight="17" Foreground="{StaticResource Text2}" />
                    </Grid>
                    <Button Content="{x:Static res:Strings.Node_ChooseOtherDevice}" Style="{StaticResource SmallToolButton}" Margin="0,10,0,0" HorizontalAlignment="Left"
                            Command="{Binding ChooseDeviceCommand}" Visibility="{Binding HasDevice, Converter={StaticResource Vis}}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- выходной порт: справа у источника и шины; круг побольше — чтобы легче попасть -->
        <Grid Width="28" Height="28" VerticalAlignment="Top" Background="Transparent" ui:Ui.Role="port-out" Cursor="Cross"
              HorizontalAlignment="Right" Margin="0,45,-14,0" ToolTip="{x:Static res:Strings.Node_PortTip}"
              Visibility="{Binding HasOutPort, Converter={StaticResource Vis}}">
            <Ellipse Width="26" Height="26" StrokeThickness="2">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="Stroke" Value="{StaticResource Accent}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding OutPort}" Value="Valid">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OutPort}" Value="Origin">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Stroke" Value="{Binding ColorBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OutPort}" Value="Forbidden">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Stroke" Value="{StaticResource Red}" />
                                <Setter Property="StrokeDashArray" Value="2 1.5" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OutPort}" Value="Occupied">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Stroke" Value="{StaticResource Faint}" />
                                <Setter Property="StrokeDashArray" Value="2 1.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <Ellipse Width="14" Height="14" Stroke="{StaticResource Bg}" StrokeThickness="3">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{Binding ColorBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding OutPort}" Value="Forbidden">
                                <Setter Property="Fill" Value="{StaticResource Red}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
        </Grid>

        <!-- входной порт: слева у шины и выхода -->
        <Grid Width="28" Height="28" VerticalAlignment="Top" Background="Transparent" ui:Ui.Role="port-in" Cursor="Cross"
              HorizontalAlignment="Left" Margin="-14,45,0,0" ToolTip="{x:Static res:Strings.Node_InPortTip}"
              Visibility="{Binding HasInPort, Converter={StaticResource Vis}}">
            <Ellipse Width="26" Height="26" StrokeThickness="2">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="Stroke" Value="{StaticResource Accent}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding InPort}" Value="Valid">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding InPort}" Value="Origin">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Stroke" Value="{Binding ColorBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding InPort}" Value="Forbidden">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Stroke" Value="{StaticResource Red}" />
                                <Setter Property="StrokeDashArray" Value="2 1.5" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding InPort}" Value="Occupied">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Stroke" Value="{StaticResource Faint}" />
                                <Setter Property="StrokeDashArray" Value="2 1.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <Ellipse Width="14" Height="14" Stroke="{StaticResource Bg}" StrokeThickness="3">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{Binding ColorBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding InPort}" Value="Forbidden">
                                <Setter Property="Fill" Value="{StaticResource Red}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
        </Grid>
    </Grid>
</UserControl>
