<UserControl x:Class="Mixer.App.Views.RackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Mixer.App.Views"
             FontFamily="{StaticResource UiFont}">
    <Grid>
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
            <Grid x:Name="Surface" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent">
                <Grid.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                </Grid.LayoutTransform>
                <!-- рейки стойки -->
                <views:RackRails x:Name="Rails" />
                <!-- модули -->
                <Canvas x:Name="Modules" />
                <!-- гнёзда, ручки проводов, подписи -->
                <Canvas x:Name="Overlay" />
                <!-- патч-кабели поверх панелей; мышь ловят модули и гнёзда под ними -->
                <views:CableLayer x:Name="Cables" IsHitTestVisible="False" />
            </Grid>
        </ScrollViewer>
        <Canvas IsHitTestVisible="False">
            <Border x:Name="ReasonTip" Visibility="Collapsed" MaxWidth="300" Padding="8,6" CornerRadius="6" Background="{StaticResource RedDeep}">
                <TextBlock x:Name="ReasonText" Foreground="{StaticResource RedPale}" FontSize="11" LineHeight="15" TextWrapping="Wrap" />
            </Border>
        </Canvas>
    </Grid>
</UserControl>
