<Window x:Class="Mixer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Mixer.App.Ui"
        xmlns:res="clr-namespace:Mixer.App.Resources"
        xmlns:views="clr-namespace:Mixer.App.Views"
        xmlns:vm="clr-namespace:Mixer.App.ViewModels"
        Title="{x:Static res:Strings.App_Title}" Width="1440" Height="900" MinWidth="960" MinHeight="560"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />
        <DataTemplate DataType="{x:Type vm:PaletteViewModel}">
            <views:PaletteView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProcessingViewModel}">
            <views:ProcessingPanel />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- ── шапка ── -->
        <Border Background="{StaticResource Bar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource Accent}">
                        <ui:Icon Data="{StaticResource IconLogo}" Foreground="#0E1116" Width="14" Height="14" StrokeThickness="2.5" />
                    </Border>
                    <TextBlock Text="{x:Static res:Strings.App_Title}" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="·" Foreground="{StaticResource Muted}" Margin="10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SaveText}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SaveFailed}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Red}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0" ToolTip="{Binding LatencyTip}">
                        <TextBlock Text="{Binding LatencyText}" FontSize="12" Foreground="{StaticResource Text2}" />
                    </Border>
                    <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0" ToolTip="{x:Static res:Strings.Header_CpuTip}">
                        <TextBlock Text="{Binding CpuText}" FontSize="12" Foreground="{StaticResource Text2}" />
                    </Border>
                    <Border Margin="0,0,8,0" ToolTip="{Binding FailuresTip}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StatusPill}">
                                <Setter Property="Background" Value="{StaticResource GreenSoft}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFailures}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource RedSoft}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding FailuresText}" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource GreenText}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFailures}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Red}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Button Style="{StaticResource IconButton}" Command="{Binding UndoCommand}" ToolTip="{x:Static res:Strings.Cmd_UndoTip}"
                            AutomationProperties.Name="{x:Static res:Strings.Cmd_Undo}">
                        <ui:Icon Data="{StaticResource IconUndo}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding RedoCommand}" ToolTip="{x:Static res:Strings.Cmd_RedoTip}"
                            AutomationProperties.Name="{x:Static res:Strings.Cmd_Redo}">
                        <ui:Icon Data="{StaticResource IconRedo}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding OpenSettingsCommand}" ToolTip="{x:Static res:Strings.Cmd_SettingsTip}"
                            AutomationProperties.Name="{x:Static res:Strings.Cmd_Settings}">
                        <ui:Icon Data="{StaticResource IconGear}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── панель инструментов ── -->
        <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,10">
            <!-- кнопки · подсказка на оставшуюся ширину (обрезается с многоточием, целиком — при наведении) · масштаб -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Command="{Binding AddSourceCommand}" Margin="0,0,8,0" ToolTip="{x:Static res:Strings.Cmd_AddSourceTip}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Data="{StaticResource IconPlus}" Foreground="{StaticResource Text}" Width="16" Height="16" Margin="0,0,6,0" />
                            <TextBlock Text="{x:Static res:Strings.Cmd_AddSource}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding AddBusNodeCommand}" Margin="0,0,8,0" ToolTip="{x:Static res:Strings.Cmd_AddBusTip}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Data="{StaticResource IconPlus}" Foreground="{StaticResource Text}" Width="16" Height="16" Margin="0,0,6,0" />
                            <TextBlock Text="{x:Static res:Strings.Cmd_AddBus}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding AddOutputCommand}" ToolTip="{x:Static res:Strings.Cmd_AddOutputTip}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Data="{StaticResource IconPlus}" Foreground="{StaticResource Text}" Width="16" Height="16" Margin="0,0,6,0" />
                            <TextBlock Text="{x:Static res:Strings.Cmd_AddOutput}" />
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="20" Background="{StaticResource Line}" Margin="12,0" />
                    <Button Style="{StaticResource ToolButton}" Command="{Binding GroupSelectedCommand}" Content="{x:Static res:Strings.Cmd_GroupIntoBus}"
                            ToolTip="{x:Static res:Strings.Cmd_GroupIntoBusTip}" ToolTipService.ShowOnDisabled="True" Margin="0,0,12,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="{x:Static res:Strings.Toolbar_Hint}" ui:TrimTip.IsEnabled="True" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" Background="{StaticResource Card}" Command="{Binding ZoomOutCommand}" ToolTip="{x:Static res:Strings.Cmd_ZoomOutTip}"
                            AutomationProperties.Name="{x:Static res:Strings.Cmd_ZoomOut}">
                        <TextBlock Text="−" Foreground="{StaticResource Text2}" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="52" Height="28" Command="{Binding ZoomResetCommand}" ToolTip="{x:Static res:Strings.Cmd_ZoomReset}"
                            AutomationProperties.Name="{x:Static res:Strings.Cmd_ZoomReset}">
                        <TextBlock Text="{Binding ZoomText}" Foreground="{StaticResource Text2}" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" Background="{StaticResource Card}" Command="{Binding ZoomInCommand}" ToolTip="{x:Static res:Strings.Cmd_ZoomInTip}"
                            AutomationProperties.Name="{x:Static res:Strings.Cmd_ZoomIn}">
                        <TextBlock Text="+" Foreground="{StaticResource Text2}" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── холст ── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <views:GraphView x:Name="Graph" Focusable="True" FocusVisualStyle="{x:Null}" />
            <!-- боковая панель обработки выбранного узла -->
            <ContentControl Grid.Column="1" Content="{Binding Processing}" Focusable="False" />
        </Grid>

        <!-- ── подвал ── -->
        <Border Grid.Row="3" Background="{StaticResource Bar}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid>
                <TextBlock Text="{Binding CountsText}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CableText}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,16,0" ToolTip="{Binding CableTip}" />
                    <TextBlock Text="{Binding SystemText}" FontSize="12" ToolTip="{Binding SystemTip}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SystemWarn}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Yellow}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── внизу холста: предложение «Сгруппировать в шину?» и всплывающее сообщение ── -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20">
            <!-- предложение после переноса схемы v1: «Сгруппировать в шину?» -->
            <Border Padding="14,12" Margin="0,0,0,8" CornerRadius="10" Width="420"
                    Background="{StaticResource Raised2}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                    Visibility="{Binding GroupOfferText, Converter={x:Static views:MainWindow.NotNullToVisible}}">
                <StackPanel>
                    <TextBlock Text="{Binding GroupOfferText}" TextWrapping="Wrap" LineHeight="18" Foreground="{StaticResource Text}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Style="{StaticResource ToolButton}" Command="{Binding DismissGroupOfferCommand}" Content="{x:Static res:Strings.Migrate_GroupDismiss}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding AcceptGroupOfferCommand}" Content="{x:Static res:Strings.Migrate_GroupAccept}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border HorizontalAlignment="Center" Padding="14,10" CornerRadius="10" MaxWidth="640"
                    BorderThickness="1" Visibility="{Binding Toast, Converter={x:Static views:MainWindow.NotNullToVisible}}" MouseLeftButtonDown="OnToastClick" Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource Raised2}" />
                        <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                                <Setter Property="Background" Value="{StaticResource RedDeep}" />
                                <Setter Property="BorderBrush" Value="#5C2B2E" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Toast}" TextWrapping="Wrap" LineHeight="18">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource RedPale}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </StackPanel>

        <!-- ── палитра и настройки поверх окна ── -->
        <Grid Grid.RowSpan="4" Background="{StaticResource Scrim}" Visibility="{Binding HasOverlay, Converter={StaticResource Vis}}" MouseLeftButtonDown="OnScrimClick">
            <ContentControl Content="{Binding Palette}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Focusable="False" />
            <ContentControl Content="{Binding Settings}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Focusable="False" />
        </Grid>
    </Grid>
</Window>
