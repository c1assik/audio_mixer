<UserControl x:Class="Mixer.App.Views.GraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Mixer.App.Ui"
             xmlns:res="clr-namespace:Mixer.App.Resources"
             xmlns:views="clr-namespace:Mixer.App.Views"
             xmlns:ed="clr-namespace:Mixer.Core.Editing;assembly=Mixer.Core"
             FontFamily="{StaticResource UiFont}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />

        <!-- подсказка провода (макет: карточка у пилюли) -->
        <DataTemplate x:Key="WireTip">
            <StackPanel>
                <TextBlock Text="{Binding TipTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding TipGain}" />
                <TextBlock Text="{Binding TipFormat}" Margin="0,2,0,0" />
                <TextBlock Text="{Binding TipFailures}" Margin="0,2,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasFailures}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Red}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding TipHint}" Foreground="{StaticResource Muted}" Margin="0,6,0,0" FontSize="11" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
            <Grid x:Name="Surface" Width="{x:Static ed:GraphLayout.Width}" Height="{Binding CanvasHeight}" Margin="16,0"
                  HorizontalAlignment="Center" VerticalAlignment="Top" Background="Transparent">
                <Grid.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                </Grid.LayoutTransform>

                <ui:WireLayer x:Name="Wires" />

                <TextBlock Text="{x:Static res:Strings.Graph_SourcesHeader}" Style="{StaticResource SectionLabel}" Margin="40,26,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <TextBlock x:Name="BusesLabel" Text="{x:Static res:Strings.Graph_BusesHeader}" Style="{StaticResource SectionLabel}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <TextBlock x:Name="OutputsLabel" Text="{x:Static res:Strings.Graph_OutputsHeader}" Style="{StaticResource SectionLabel}" HorizontalAlignment="Left" VerticalAlignment="Top" />

                <!-- пилюли проводов -->
                <ItemsControl ItemsSource="{Binding Wires}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding PillX}" />
                            <Setter Property="Canvas.Top" Value="{Binding PillY}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Height="22" CornerRadius="11" Background="{StaticResource Bg}" Cursor="SizeNS"
                                    ui:Ui.Role="pill" ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="60000">
                                <Border.ToolTip>
                                    <ToolTip Content="{Binding}" ContentTemplate="{StaticResource WireTip}" />
                                </Border.ToolTip>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{Binding Source.ColorBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Width" Value="56" />
                                        <Setter Property="Margin" Value="-28,-11,0,0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPillOff}" Value="True">
                                                <Setter Property="BorderBrush" Value="#5F656D" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                                <Setter Property="Opacity" Value="0.35" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDetached}" Value="True">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                            <!-- прямой маршрут: шире, со значком молнии -->
                                            <DataTrigger Binding="{Binding ShowDirect}" Value="True">
                                                <Setter Property="Width" Value="84" />
                                                <Setter Property="Margin" Value="-42,-11,0,0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:Icon Data="{StaticResource IconBolt}" Width="11" Height="11" Margin="0,0,4,0" StrokeThickness="2.5" Foreground="{Binding Source.ColorBrush}"
                                         Visibility="{Binding ShowDirect, Converter={StaticResource Vis}}" />
                                <TextBlock Text="{Binding PillText}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPillOff}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- карточки узлов -->
                <ItemsControl ItemsSource="{Binding Nodes}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:NodeCard />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- причина запрета у курсора, пока тянут провод -->
                <Canvas IsHitTestVisible="False">
                    <Border x:Name="ReasonTip" Visibility="Collapsed" MaxWidth="300" Padding="8,6" CornerRadius="6" Background="{StaticResource RedDeep}">
                        <TextBlock x:Name="ReasonText" Foreground="{StaticResource RedPale}" FontSize="11" LineHeight="15" TextWrapping="Wrap" />
                    </Border>
                </Canvas>
            </Grid>
        </ScrollViewer>

        <!-- пустая схема -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Padding="28,24" CornerRadius="14"
                Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Graph_EmptyTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text2}" Margin="0,8,0,0" LineHeight="19"
                           Text="{x:Static res:Strings.Graph_EmptyText}" />
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddSourceCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Data="{StaticResource IconPlus}" Foreground="#0E1116" Width="16" Height="16" Margin="0,0,6,0" />
                            <TextBlock Text="{x:Static res:Strings.Cmd_AddSource}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding AddOutputCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Data="{StaticResource IconPlus}" Foreground="{StaticResource Text}" Width="16" Height="16" Margin="0,0,6,0" />
                            <TextBlock Text="{x:Static res:Strings.Cmd_AddOutput}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
