<UserControl x:Class="Mixer.App.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Mixer.App.Ui"
             xmlns:res="clr-namespace:Mixer.App.Resources"
             xmlns:views="clr-namespace:Mixer.App.Views"
             Width="680" Height="600" FontFamily="{StaticResource UiFont}" FontSize="13"
             AutomationProperties.Name="{x:Static res:Strings.Setup_Title}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />
        <!-- полоска шага: заполнена до текущего шага -->
        <Style x:Key="StepBar" TargetType="Border">
            <Setter Property="Height" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{StaticResource Raised2}" />
        </Style>
        <!-- иконка варианта в квадрате -->
        <Style x:Key="OptionIcon" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{StaticResource Raised2}" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <DataTemplate x:Key="DeviceRow">
            <Button Style="{StaticResource ChoiceRow}" Margin="0,0,0,2" AutomationProperties.Name="{Binding Title}"
                    Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="Medium" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" ui:TrimTip.IsEnabled="True" MaxWidth="250" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ui:TrimTip.IsEnabled="True" MaxWidth="250"
                               Visibility="{Binding Subtitle, Converter={x:Static views:MainWindow.NotNullToVisible}}" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{StaticResource Card}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- шаги и заголовок -->
            <StackPanel Margin="24,20,24,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource StepBar}" Background="{StaticResource Accent}" />
                    <Border Grid.Column="2">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepBar}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Bar2}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Border Grid.Column="4">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepBar}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Bar3}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>
                <Grid Margin="0,14,0,0">
                    <TextBlock Text="{Binding StepText}" FontSize="12" Foreground="{StaticResource Muted}" />
                    <TextBlock Text="{x:Static res:Strings.Setup_Title}" FontSize="12" Foreground="{StaticResource Faint}" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>

            <!-- содержимое шага -->
            <Grid Grid.Row="1" Margin="24,8,24,12">
                <!-- шаг 1: устройства -->
                <Grid Visibility="{Binding IsStep1, Converter={StaticResource Vis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Static res:Strings.Setup_DevicesTitle}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                    <TextBlock Grid.Row="1" Text="{x:Static res:Strings.Setup_DevicesText}" Foreground="{StaticResource Text2}" TextWrapping="Wrap" Margin="0,8,0,12" LineHeight="19" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:Icon Data="{StaticResource IconHeadphones}" Foreground="{StaticResource Muted}" Width="16" Height="16" Margin="0,0,8,0" />
                                <TextBlock Text="{x:Static res:Strings.Setup_Headphones}" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                <ItemsControl ItemsSource="{Binding Outputs}" ItemTemplate="{StaticResource DeviceRow}" Tag="{Binding PickOutputCommand}" Focusable="False" />
                            </ScrollViewer>
                        </DockPanel>
                        <DockPanel Grid.Column="2">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:Icon Data="{StaticResource IconMic}" Foreground="{StaticResource Muted}" Width="16" Height="16" Margin="0,0,8,0" />
                                <TextBlock Text="{x:Static res:Strings.Setup_Microphone}" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                <ItemsControl ItemsSource="{Binding Inputs}" ItemTemplate="{StaticResource DeviceRow}" Tag="{Binding PickInputCommand}" Focusable="False" />
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </Grid>

                <!-- шаг 2: куда отдать звук (макет «Setup assistant, step 2») -->
                <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource Vis}}">
                    <TextBlock Text="{x:Static res:Strings.Setup_WhereTitle}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                    <TextBlock Text="{x:Static res:Strings.Setup_WhereText}" Foreground="{StaticResource Text2}" TextWrapping="Wrap" Margin="0,8,0,16" LineHeight="19" />
                    <ToggleButton Style="{StaticResource OptionCard}" IsChecked="{Binding HeadphonesOnly}" Margin="0,0,0,10"
                                  AutomationProperties.Name="{x:Static res:Strings.Setup_HeadphonesOnly}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource OptionIcon}">
                                <ui:Icon Data="{StaticResource IconHeadphones}" Foreground="{StaticResource Text2}" Width="16" Height="16" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Static res:Strings.Setup_HeadphonesOnly}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Static res:Strings.Setup_HeadphonesOnlyText}" FontSize="12" Foreground="{StaticResource Text2}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource OptionCard}" IsChecked="{Binding Stream}" Margin="0,0,0,10"
                                  AutomationProperties.Name="{x:Static res:Strings.Setup_Stream}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource OptionIcon}">
                                <ui:Icon Data="{StaticResource IconBroadcast}" Foreground="{StaticResource Text2}" Width="16" Height="16" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Static res:Strings.Setup_Stream}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Static res:Strings.Setup_StreamText}" FontSize="12" Foreground="{StaticResource Text2}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource OptionCard}" IsChecked="{Binding Call}" Margin="0,0,0,10"
                                  AutomationProperties.Name="{x:Static res:Strings.Setup_Call}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource OptionIcon}">
                                <ui:Icon Data="{StaticResource IconApp}" Foreground="{StaticResource Text2}" Width="16" Height="16" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Static res:Strings.Setup_Call}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Static res:Strings.Setup_CallText}" FontSize="12" Foreground="{StaticResource Text2}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </ToggleButton>
                    <!-- кабели: хватает или сколько поставить -->
                    <Border CornerRadius="10" Padding="14,10" BorderThickness="1" Margin="0,2,0,0"
                            Visibility="{Binding CablesText, Converter={x:Static views:MainWindow.NotNullToVisible}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource Raised}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CablesShort}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource YellowSoft}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Yellow}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:Icon Data="{StaticResource IconWarn}" Foreground="{StaticResource Yellow}" Width="16" Height="16" Margin="0,1,10,0" VerticalAlignment="Top"
                                     Visibility="{Binding CablesShort, Converter={StaticResource Vis}}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding CablesText}" TextWrapping="Wrap" LineHeight="19" Foreground="{StaticResource Text}" />
                                <Button Style="{StaticResource LinkButton}" Content="{x:Static res:Strings.Setup_WhereToGet}" Command="{Binding OpenCableSiteCommand}"
                                        HorizontalAlignment="Left" Margin="0,2,0,0" Visibility="{Binding CablesShort, Converter={StaticResource Vis}}" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource SmallToolButton}" Content="{x:Static res:Strings.Setup_CheckAgain}" Command="{Binding CheckAgainCommand}"
                                    VerticalAlignment="Center" Margin="12,0,0,0" Visibility="{Binding CablesShort, Converter={StaticResource Vis}}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- шаг 3: какие приложения держать отдельно -->
                <Grid Visibility="{Binding IsStep3, Converter={StaticResource Vis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Static res:Strings.Setup_AppsTitle}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                    <TextBlock Grid.Row="1" Text="{x:Static res:Strings.Setup_AppsText}" Foreground="{StaticResource Text2}" TextWrapping="Wrap" Margin="0,8,0,12" LineHeight="19" />
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel>
                            <TextBlock Text="{x:Static res:Strings.Setup_AppsLoading}" Foreground="{StaticResource Muted}" Visibility="{Binding AppsLoading, Converter={StaticResource Vis}}" />
                            <TextBlock Text="{x:Static res:Strings.Setup_AppsNone}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Visibility="{Binding NoApps, Converter={StaticResource Vis}}" />
                            <ItemsControl ItemsSource="{Binding Apps}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked}" Margin="0,0,12,10" AutomationProperties.Name="{Binding Name}">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" Visibility="{Binding HasIcon, Converter={StaticResource Vis}}" />
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="220" ui:TrimTip.IsEnabled="True" />
                                                <Ellipse Width="6" Height="6" Fill="{StaticResource Green}" Margin="6,0,0,0" Visibility="{Binding Playing, Converter={StaticResource Vis}}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                        <CheckBox IsChecked="{Binding Autostart}" Content="{x:Static res:Strings.Setup_Autostart}" />
                        <TextBlock Text="{x:Static res:Strings.Setup_ReplaceNote}" FontSize="12" Foreground="{StaticResource Yellow}" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding ReplacesGraph, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- кнопки -->
            <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,14">
                <Grid>
                    <Button Style="{StaticResource ToolButton}" Background="Transparent" BorderThickness="0" Content="{x:Static res:Strings.Setup_Skip}" Command="{Binding SkipCommand}"
                            HorizontalAlignment="Left" Foreground="{StaticResource Muted}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ToolButton}" Content="{x:Static res:Strings.Setup_Back}" Command="{Binding BackCommand}" Margin="0,0,8,0"
                                Visibility="{Binding CanBack, Converter={StaticResource Vis}}" />
                        <Button Style="{StaticResource PrimaryButton}" Content="{x:Static res:Strings.Setup_Next}" Command="{Binding NextCommand}"
                                Visibility="{Binding NotLast, Converter={StaticResource Vis}}" ToolTipService.ShowOnDisabled="True" />
                        <Button Style="{StaticResource PrimaryButton}" Content="{x:Static res:Strings.Setup_Finish}" Command="{Binding FinishCommand}"
                                Visibility="{Binding IsLast, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
