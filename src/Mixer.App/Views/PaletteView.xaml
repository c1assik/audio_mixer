<UserControl x:Class="Mixer.App.Views.PaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Mixer.App.Ui"
             xmlns:res="clr-namespace:Mixer.App.Resources"
             Width="560" MaxHeight="620" FontFamily="{StaticResource UiFont}" FontSize="13">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />
    </UserControl.Resources>
    <Border Background="{StaticResource Card}" BorderBrush="{StaticResource DialogBorder}" BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,16,16,12">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" HorizontalAlignment="Right" Click="OnClose" ToolTip="{x:Static res:Strings.Cmd_CloseTip}"
                                AutomationProperties.Name="{x:Static res:Strings.Cmd_Close}">
                            <ui:Icon Data="{StaticResource IconClose}" Foreground="{StaticResource Muted}" Width="16" Height="16" />
                        </Button>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <TextBox x:Name="Search" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Placeholder}" Height="40" FontSize="14" Padding="34,0,8,0"
                                 BorderBrush="{StaticResource Accent}" PreviewKeyDown="OnSearchKey" />
                        <ui:Icon Data="{StaticResource IconSearch}" Foreground="{StaticResource Muted}" Width="16" Height="16" HorizontalAlignment="Left" Margin="12,0,0,0" />
                        <TextBlock Text="{Binding Placeholder}" Foreground="{StaticResource Faint}" FontSize="14" Margin="38,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <!-- выбор плагина: «проверено 34 из 61», пока идёт скан -->
                    <TextBlock Text="{Binding ScanText}" Foreground="{StaticResource Muted}" FontSize="12" Margin="2,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScanText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <ListBox x:Name="List" ItemsSource="{Binding Rows}" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
                         Padding="8" ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.TabNavigation="None" Focusable="False">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="IsEnabled" Value="{Binding Enabled}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Margin="0,1">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                    <Condition Binding="{Binding IsHeader}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Raised}" />
                                            </MultiDataTrigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <EventSetter Event="MouseLeftButtonUp" Handler="OnRowClick" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Setter Property="IsHitTestVisible" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding Header}" Style="{StaticResource SectionLabel}" Margin="8,10,8,4"
                                           Visibility="{Binding IsHeader, Converter={StaticResource Vis}}" />
                                <Grid MinHeight="44" Margin="8,6" ToolTip="{Binding Reason}" ToolTipService.ShowOnDisabled="True">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource Raised2}" VerticalAlignment="Center">
                                        <Grid>
                                            <ui:Icon Data="{Binding Glyph}" Foreground="{StaticResource Text2}" Width="16" Height="16" />
                                            <Image Source="{Binding Icon}" Width="18" Height="18" Visibility="{Binding HasIcon, Converter={StaticResource Vis}}"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="Medium" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" ui:TrimTip.IsEnabled="True" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ui:TrimTip.IsEnabled="True" />
                                    </StackPanel>
                                    <!-- «играет звук» -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="14"
                                                Visibility="{Binding Playing, Converter={StaticResource Vis}}" ToolTip="{x:Static res:Strings.Palette_PlayingAudio}">
                                        <Rectangle Width="3" Height="8" RadiusX="1" RadiusY="1" Fill="{StaticResource Green}" VerticalAlignment="Bottom" Margin="0,0,2,0" />
                                        <Rectangle Width="3" Height="14" RadiusX="1" RadiusY="1" Fill="{StaticResource Green}" VerticalAlignment="Bottom" Margin="0,0,2,0" />
                                        <Rectangle Width="3" Height="10" RadiusX="1" RadiusY="1" Fill="{StaticResource Green}" VerticalAlignment="Bottom" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{x:Static res:Strings.Palette_Loading}" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Loading, Converter={StaticResource Vis}}" />
                <TextBlock Text="{x:Static res:Strings.Palette_NothingFound}" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}" />
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Red}" TextWrapping="Wrap" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static res:Strings.Palette_KeySelect}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,16,0" />
                    <TextBlock Text="{x:Static res:Strings.Palette_KeyAdd}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,16,0" />
                    <TextBlock Text="{x:Static res:Strings.Palette_KeyClose}" Foreground="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
