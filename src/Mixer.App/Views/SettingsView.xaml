<UserControl x:Class="Mixer.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Mixer.App.Ui"
             xmlns:res="clr-namespace:Mixer.App.Resources"
             xmlns:views="clr-namespace:Mixer.App.Views"
             Width="600" MaxHeight="660" FontFamily="{StaticResource UiFont}" FontSize="13">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />
    </UserControl.Resources>
    <Border Background="{StaticResource Card}" BorderBrush="#33373D" BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="20,16,16,0">
                <TextBlock Text="{x:Static res:Strings.Cmd_Settings}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                <Button Style="{StaticResource IconButton}" Width="28" Height="28" HorizontalAlignment="Right" Command="{Binding CloseCommand}" ToolTip="{x:Static res:Strings.Cmd_CloseTip}"
                        AutomationProperties.Name="{x:Static res:Strings.Cmd_Close}">
                    <ui:Icon Data="{StaticResource IconClose}" Foreground="{StaticResource Muted}" Width="16" Height="16" />
                </Button>
            </Grid>

            <!-- язык: применяется после перезапуска -->
            <StackPanel Grid.Row="1" Margin="20,16,20,0" DataContext="{Binding Language}"
                        Visibility="{Binding Converter={x:Static views:MainWindow.NotNullToVisible}}">
                <TextBlock Text="{x:Static res:Strings.Settings_LanguageHeader}" Style="{StaticResource SectionLabel}" />
                <ItemsControl ItemsSource="{Binding Options}" Margin="-8,6,0,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                    Cursor="Hand" Margin="0,0,4,0" AutomationProperties.Name="{Binding Title}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="8,7,12,7">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Raised}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="24">
                                        <Ellipse Width="16" Height="16" StrokeThickness="2" Stroke="{StaticResource LineStrong}" HorizontalAlignment="Left" />
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" HorizontalAlignment="Left" Margin="4,0,0,0"
                                                 Visibility="{Binding IsCurrent, Converter={StaticResource Vis}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Title}" FontWeight="Medium" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Margin="0,8,0,0" Padding="12,8" CornerRadius="8" Background="{StaticResource Raised}"
                        Visibility="{Binding Note, Converter={x:Static views:MainWindow.NotNullToVisible}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Note}" Foreground="{StaticResource Text2}" TextWrapping="Wrap" LineHeight="18" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="{x:Static res:Strings.Settings_LanguageRestart}" Style="{StaticResource SmallToolButton}"
                                Command="{Binding RestartCommand}" Margin="12,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding NeedsRestart, Converter={StaticResource Vis}}" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="20,16,20,8">
                <TextBlock Text="{x:Static res:Strings.Settings_SinkHeader}" Style="{StaticResource SectionLabel}" />
                <TextBlock Text="{Binding PolicyText}" Foreground="{StaticResource Text2}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="18" />
                <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource Raised}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Verdict}" Value="Ok">
                                    <Setter Property="Background" Value="{StaticResource GreenSoft}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Verdict}" Value="Warning">
                                    <Setter Property="Background" Value="{StaticResource YellowSoft}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Verdict}" Value="Rejected">
                                    <Setter Property="Background" Value="{StaticResource RedSoft}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" LineHeight="18">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Text2}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Verdict}" Value="Ok">
                                        <Setter Property="Foreground" Value="{StaticResource GreenText}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Verdict}" Value="Warning">
                                        <Setter Property="Foreground" Value="{StaticResource Yellow}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Verdict}" Value="Rejected">
                                        <Setter Property="Foreground" Value="{StaticResource Red}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>

            <ListBox Grid.Row="3" ItemsSource="{Binding Devices}" Background="Transparent" BorderThickness="0" Margin="12,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                Cursor="Hand" Margin="0,1">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="8,8">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Raised}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="16" Height="16" StrokeThickness="2" Stroke="{StaticResource LineStrong}" HorizontalAlignment="Left" />
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" HorizontalAlignment="Left" Margin="4,0,0,0"
                                         Visibility="{Binding IsCurrent, Converter={StaticResource Vis}}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="Medium" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Static res:Strings.Settings_Checking}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"
                                           Visibility="{Binding IsChecking, Converter={StaticResource Vis}}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="4" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{x:Static res:Strings.Settings_ClearSink}" Style="{StaticResource SmallToolButton}" Command="{Binding ClearCommand}" Margin="0,0,8,0"
                                Visibility="{Binding HasSink, Converter={StaticResource Vis}}" />
                        <Button Content="{x:Static res:Strings.Settings_VolumeMixer}" Style="{StaticResource SmallToolButton}" Command="{Binding OpenVolumeMixerCommand}"
                                ToolTip="{x:Static res:Strings.Settings_VolumeMixerTip}" />
                    </StackPanel>
                    <TextBlock Text="{Binding LoopbackText}" Foreground="{StaticResource Faint}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="240" ToolTip="{Binding LoopbackText}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
