<?xml version="1.0" encoding="utf-8"?>
<!--
  Выпуск: один Mixer.exe, которому не нужен установленный .NET.
    dotnet publish src/Mixer.App -c Release -p:PublishProfile=win-x64
  Обычно его вызывает tools/publish.ps1 (тесты, сборка, подпись, контрольная сумма).
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- нативные библиотеки WPF (wpfgfx, PresentationNative, D3DCompiler) — внутри exe, а не рядом -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- заранее скомпилированный код: меньше JIT при запуске и при первом открытии узлов (риск «паузы GC и JIT») -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- WPF не поддерживает обрезку сборок -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- строки журнала с номерами строк кода при падении -->
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\dist\</PublishDir>
  </PropertyGroup>
</Project>
